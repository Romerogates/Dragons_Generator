        "name": "Voie du berserker",
        "flavor": {
          "summary": "Violence déchaînée et frénésie sanglante. Attaque en action bonus chaque tour de rage au prix d'un niveau de fatigue post-rage.",
          "lore_note": "Le terme berserker proviendrait d'un mot nordique désignant l'ours. Les berserkers sont présents dans de nombreuses civilisations d'Eana : cavalerie kaani, élite pied-sûr halfeline, opprimés révoltés."
        },
        "features_details": [
          {
            "id": "feat-frenesie",
            "name": "Frénésie",
            "unlocks_at_level": 3,
            "recharge": "at_will",
            "action_type": "bonus_action",
            "flavor": {
              "summary": "Durant la rage (à partir du tour suivant l'entrée), une attaque d'arme CaC en action bonus par tour. À la fin de la rage : +1 niveau de fatigue.",
              "lore_note": null
            },
            "mechanics": {
              "trigger": "during_rage_each_turn_after_entry_turn",
              "bonus_attack": {
                "type": "melee_weapon",
                "action_cost": "bonus_action"
              },
              "cost_on_rage_end": {
                "type": "exhaustion_gain",
                "levels": 1
              }
            }
          },
          {
            "id": "feat-rage-aveugle",
            "name": "Rage aveugle",
            "unlocks_at_level": 6,
            "recharge": "passive",
            "flavor": {
