  "features_details": [
    {
      "id": "feat-rage",
      "name": "Rage",
      "unlocks_at_level": 1,
      "recharge": "long_rest",
      "action_type": "bonus_action",
      "flavor": {
        "summary": "Transe de combat octroyant avantages offensifs (Force), bonus aux dégâts et résistances physiques. Incompatible avec l'incantation et la concentration.",
        "lore_note": "Le feu intérieur du barbare lui permet d'entrer dans une transe de bataille, encaissant des blessures qui feraient s'évanouir n'importe qui d'autre."
      },
      "mechanics": {
        "duration_minutes": 1,
        "activation_condition": "no_heavy_armor",
        "termination_conditions": [
          "unconscious",
          "end_of_turn_no_hostile_attack_and_no_damage_taken",
          "voluntary_bonus_action"
        ],
        "advantages": [
          {
            "type": "ability_check",
            "target": "str"
          },
          {
            "type": "saving_throw",
            "target": "str"
          }
        ],
        "damage_bonus": {
          "source_column": "rage_damage_bonus",
          "condition": "melee_weapon_attack_using_str"
        },
        "resistances": [
          "bludgeoning",
          "piercing",
          "slashing"
        ],
        "restrictions": [
          "cannot_cast_spells",
          "cannot_maintain_concentration"
        ]
      },
      "uses": {
        "source_column": "rage_count",
        "null_means_unlimited": true
      }
    },
    {
      "id": "feat-defense-sans-armure",
      "name": "Défense sans armure",
      "unlocks_at_level": 1,
      "recharge": "passive",
      "flavor": {
        "summary": "Sans armure équipée, la CA vaut 10 + modificateur de Dextérité + modificateur de Constitution. Un bouclier reste utilisable.",
        "lore_note": null
      },
      "mechanics": {
        "condition": "no_armor_equipped",
        "ac_formula": "10 + dex_mod + con_mod",
        "shield_compatible": true
      }
    },
    {
      "id": "feat-attaque-debridee",
      "name": "Attaque débridée",
      "unlocks_at_level": 2,
      "recharge": "at_will",
      "action_type": "free_on_first_attack_of_turn",
      "flavor": {
        "summary": "Avantage à tous les jets d'attaque d'arme CaC (Force) ce tour. En contrepartie, les attaquants ont l'avantage contre vous jusqu'à votre prochain tour.",
        "lore_note": null
      },
      "mechanics": {
        "advantages": [
          {
            "type": "attack_roll",
            "target": "melee_weapon_str",
            "scope": "all_attacks_this_turn"
          }
        ],
        "grants_advantage_to_attackers": {
          "scope": "all_attacks_against_self",
          "duration": "until_start_of_next_turn"
        }
      }
    },
    {
      "id": "feat-sens-du-danger",
      "name": "Sens du danger",
      "unlocks_at_level": 2,
      "recharge": "passive",
      "flavor": {
        "summary": "Avantage aux jets de sauvegarde de Dextérité contre les effets visibles (pièges, sorts). Inopérant si aveuglé, assourdi ou neutralisé.",
        "lore_note": null
      },
      "mechanics": {
        "advantages": [
          {
            "type": "saving_throw",
            "target": "dex",
            "condition": "against_visible_effects_traps_spells"
          }
        ],
        "nullified_by_conditions": [
          "blinded",
          "deafened",
          "incapacitated"
        ]
      }
    },
