  "features_details": [
    {
      "id": "feat-expertise-cls-roublard",
      "name": "Expertise",
      "unlocks_at_level": 1,
      "recharge": "passive",
      "action_type": null,
      "flavor": {
        "summary": "Double le bonus de maîtrise pour deux maîtrises choisies au niveau 1, puis deux autres au niveau 6.",
        "lore_note": null
      },
      "mechanics": {
        "description": "Choisissez deux maîtrises de compétence, ou une compétence et la maîtrise des outils de voleur. Le bonus de maîtrise est doublé pour tout test associé. Au niveau 6, sélectionnez deux maîtrises supplémentaires.",
        "effect": "double_proficiency_bonus",
        "triggers": [
          {
            "level": 1,
            "choice_pool_ref": "choice-expertise-1-cls-roublard"
          },
          {
            "level": 6,
            "choice_pool_ref": "choice-expertise-2-cls-roublard"
          }
        ]
      }
    },
    {
      "id": "feat-attaque-sournoise-cls-roublard",
      "name": "Attaque sournoise",
      "unlocks_at_level": 1,
      "recharge": "at_will",
      "action_type": "part_of_attack",
      "uses_per_turn": 1,
      "flavor": {
        "summary": "Frappe précise exploitant la moindre inattention adverse pour infliger des dégâts supplémentaires.",
        "lore_note": null
      },
      "mechanics": {
        "description": "Une fois par tour, inflige des dégâts supplémentaires (resources.sneak_attack_dice) à une créature touchée avec une arme à distance ou à finesse, si vous avez un avantage au jet d'attaque. L'avantage n'est pas requis si un allié non neutralisé est à ≤ 1,50 m de la cible et que vous n'avez pas de désavantage.",
        "weapon_restriction": [
          "ranged",
          "finesse"
        ],
        "scaling_resource_key": "sneak_attack_dice",
        "alternate_condition": {
          "ally_adjacent_to_target_range_m": 1.5,
          "condition": "no_disadvantage_on_attack"
        }
      }
    },
    {
      "id": "feat-argot-des-voleurs-cls-roublard",
      "name": "Argot des voleurs",
      "unlocks_at_level": 1,
      "recharge": "passive",
      "action_type": null,
      "flavor": {
        "summary": "Langage secret permettant de glisser des messages codés dans des conversations ordinaires.",
        "lore_note": "Présenté dans le chapitre Langues. Note : intitulé 'Argot du milieu' dans la table de progression ; 'Argot des voleurs' dans la description canonique — l'ID normalise sur la désignation descriptive."
      },
      "mechanics": {
        "description": "Maîtrise de l'argot des voleurs, langue secrète pour communiquer des messages dissimulés (temps ×4). Connaissance de signes secrets indiquant dangers, richesses, guildes et refuges.",
        "grants_language": "lang-argot-des-voleurs"
      }
    },
    {
      "id": "feat-roublardise-cls-roublard",
      "name": "Roublardise",
      "unlocks_at_level": 2,
      "recharge": "at_will",
      "action_type": "bonus_action",
      "flavor": {
        "summary": "Vivacité d'esprit et de corps permettant d'agir plus vite en combat.",
        "lore_note": null
      },
      "mechanics": {
        "description": "À chaque tour en combat, vous disposez d'une action bonus permettant uniquement d'entreprendre Foncer, Se cacher ou Se dégager.",
        "allowed_bonus_actions": [
          "foncer",
          "se-cacher",
          "se-degager"
        ]
      }
    },
    {
      "id": "feat-choix-archetype-cls-roublard",
      "name": "Archétype roublard",
      "unlocks_at_level": 3,
      "recharge": "passive",
      "action_type": null,
      "flavor": {
        "summary": "Choix d'un archétype définissant la tendance forte du roublard parmi Voleur, Espion et Sicaire.",
        "lore_note": null
      },
      "mechanics": {
        "description": "Au niveau 3, choisissez un archétype. Des aptitudes d'archétype sont octroyées aux niveaux 3, 9, 13 et 17.",
        "subclass_feature_levels": [
          3,
          9,
          13,
          17
        ]
      }
    },
    {
      "id": "feat-asi-cls-roublard",
