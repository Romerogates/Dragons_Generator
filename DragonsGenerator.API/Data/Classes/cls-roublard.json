      "unlocks_at_level": 4,
      "recharge": "passive",
      "action_type": null,
      "flavor": {
        "summary": "Développement ponctuel d'une ou deux caractéristiques.",
        "lore_note": null
      },
      "mechanics": {
        "description": "Augmentez une valeur de caractéristique de 2, ou deux valeurs de 1 chacune. Maximum 20.",
        "applies_at_levels": [
          4,
          8,
          10,
          12,
          16,
          19
        ]
      }
    },
    {
      "id": "feat-esquive-instinctive-cls-roublard",
      "name": "Esquive instinctive",
      "unlocks_at_level": 5,
      "recharge": "at_will",
      "action_type": "reaction",
      "flavor": {
        "summary": "Réflexes permettant de réduire de moitié les dégâts d'une attaque vue venir.",
        "lore_note": null
      },
      "mechanics": {
        "description": "Lorsqu'un assaillant que vous voyez vous touche avec une attaque, utilisez votre réaction pour réduire de moitié les dégâts subis.",
        "trigger": "visible_attacker_hits",
        "effect": "halve_damage"
      }
    },
    {
      "id": "feat-esquive-totale-cls-roublard",
      "name": "Esquive totale",
      "unlocks_at_level": 7,
      "recharge": "at_will",
      "action_type": null,
      "flavor": {
        "summary": "Agilité permettant d'éviter totalement les effets de zone sur jet de sauvegarde de Dextérité réussi.",
        "lore_note": null
      },
      "mechanics": {
        "description": "Lorsque vous êtes soumis à un effet exigeant un jet de sauvegarde de DEX pour réduire les dégâts de moitié : succès = 0 dégât ; échec = moitié des dégâts.",
        "saving_throw_upgrade": {
          "type": "dex",
          "on_success": "no_damage",
          "on_failure": "half_damage"
        }
      }
    },
    {
