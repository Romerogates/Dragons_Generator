  "features_details": [
    {
      "id": "feat-incantation-barde",
      "name": "Sorts",
      "unlocks_at_level": 1,
      "recharge": "passive",
      "action_cost": null,
      "flavor": {
        "summary": "Le barde détisse la trame de la réalité grâce à son répertoire musical pour façonner des effets magiques variés.",
        "lore_note": null
      },
      "mechanics": {
        "spellcasting_ability": "cha",
        "spell_save_dc_formula": "8 + prof_bonus + cha_mod",
        "spell_attack_bonus_formula": "prof_bonus + cha_mod",
        "ritual_casting": true,
        "focus": "category-musical-instruments",
        "allows_swap_on_levelup": true,
        "note": "Type known. Le barde peut remplacer un sort connu par un autre de la liste de barde à chaque montée de niveau."
      }
    },
    {
      "id": "feat-inspiration-bardique",
      "name": "Inspiration bardique",
      "unlocks_at_level": 1,
      "recharge": "long_rest",
      "recharge_override": {
        "from_level": 5,
        "new_recharge": "short_rest",
        "source_feature": "feat-fontaine-dinspiration"
      },
      "action_cost": "bonus_action",
      "flavor": {
        "summary": "Paroles et musique du barde inspirent une créature proche, lui octroyant un dé qu'elle peut ajouter à un jet futur.",
        "lore_note": null
      },
      "mechanics": {
        "range_meters": 18,
        "target": "one_friendly_creature_not_self",
        "die_scaling": {
          "1": "d6",
          "5": "d8",
          "10": "d10",
          "15": "d12"
        },
        "uses_formula": "max(1, cha_mod)",
        "duration_minutes": 10,
        "applicable_to": [
          "ability_check",
          "attack_roll",
          "saving_throw"
        ],
        "timing": "after_d20_before_outcome_announced",
        "max_dice_per_creature": 1
      }
    },
    {
      "id": "feat-touche-a-tout",
      "name": "Touche-à-tout",
      "unlocks_at_level": 2,
      "recharge": "passive",
      "action_cost": null,
      "flavor": {
        "summary": "La curiosité encyclopédique du barde lui permet d'appliquer la moitié de son bonus de maîtrise aux compétences non maîtrisées.",
        "lore_note": null
      },
      "mechanics": {
        "effect": "add_half_prof_bonus_to_non_proficient_checks",
        "formula": "floor(prof_bonus / 2)"
      }
    },
    {
      "id": "feat-chant-reparateur",
      "name": "Chant réparateur",
      "unlocks_at_level": 2,
      "recharge": "passive",
      "action_cost": null,
      "flavor": {
        "summary": "La musique ou l'art oratoire du barde permet à ses alliés de récupérer des points de vie supplémentaires lors d'un repos court.",
        "lore_note": null
      },
      "mechanics": {
        "trigger": "short_rest_spend_hit_dice",
        "target": "all_friendly_creatures_that_can_hear",
        "die_scaling": {
          "2": "d6",
          "9": "d8",
          "13": "d10",
          "17": "d12"
        },
        "effect": "Ajouter le résultat du dé de chant réparateur aux PV récupérés via les dés de vie lors du repos court."
      }
    },
    {
      "id": "feat-college-bardique",
      "name": "Collège bardique",
      "unlocks_at_level": 3,
      "recharge": "passive",
      "action_cost": null,
