    "options": [
      {
        "id": "subcls-serment-de-devotion",
        "name": "Serment de dévotion",
        "flavor": {
          "summary": "Le paladin de dévotion incarne les plus purs idéaux de justice, de vertu et d'ordre. Les anges (serviteurs immaculés du Bien) sont ses modèles.",
          "lore_note": "Parfois appelés cavaliers royaux, chevaliers blancs ou guerriers saints. Beaucoup vénèrent une divinité de la loi et de l'ordre."
        },
