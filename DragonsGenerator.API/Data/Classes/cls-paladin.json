  "features_details": [
    {
      "id": "feat-perception-divine",
      "name": "Perception divine",
      "unlocks_at_level": 1,
      "recharge": "long_rest",
      "uses": {
        "formula": "1 + cha_mod"
      },
      "action_type": "action",
      "flavor": {
        "summary": "Jusqu'à la fin de votre prochain tour, vous percevez la position et le type de tout céleste, fiélon, ravageur du Chancre et mort-vivant dans un rayon de 18 m, ainsi que les zones sanctifiées ou profanées.",
        "lore_note": "La proximité du mal agresse les sens du paladin comme la pire des odeurs ; l'aura du Bien résonne telle la plus douce des musiques."
      },
      "mechanics": {
        "range_m": 18,
        "duration": "until_end_of_next_turn",
        "detects": [
          "celeste",
          "fielon",
          "ravageur-du-chancre",
          "mort-vivant",
          "zone-sanctifiee",
          "zone-profanee"
        ],
        "reveals": [
          "position",
          "type"
        ],
        "does_not_reveal": [
          "identity"
        ],
        "blocked_by": [
          "full_cover"
        ]
      }
    },
    {
      "id": "feat-imposition-des-mains",
      "name": "Imposition des mains",
      "unlocks_at_level": 1,
      "recharge": "long_rest",
      "uses": {
        "pool_label": "imposition_pool",
        "pool_formula": "paladin_level * 5"
      },
      "action_type": "action",
      "flavor": {
        "summary": "Votre sainteté se manifeste par un contact guérisseur. Vous gérez une réserve de puissance curatrice (5 × niveau) rechargée au repos long.",
        "lore_note": null
      },
      "mechanics": {
        "applications": [
          {
            "name": "Soin",
            "cost_from_pool": "variable",
            "effect": "Restaure un nombre de PV inférieur ou égal au solde disponible."
          },
          {
            "name": "Guérison ou neutralisation",
            "cost_from_pool": 5,
            "effect": "Guérit une maladie ou neutralise un poison. Cumulable : 5 PV par affection distincte."
          }
        ],
        "exclusions": [
          "mort-vivant",
          "creature-artificielle"
        ]
      }
    },
    {
      "id": "feat-style-de-combat-paladin",
      "name": "Style de combat",
      "unlocks_at_level": 2,
      "recharge": "passive",
      "action_type": null,
      "flavor": {
        "summary": "Spécialisation dans un style de combat martial. Ne peut jamais être repris pour choisir le même style une seconde fois.",
        "lore_note": null
      },
      "choice_pool_ref": "choice-combat-style-cls-paladin"
    },
    {
      "id": "feat-sorts-paladin",
      "name": "Sorts",
      "unlocks_at_level": 2,
      "recharge": "passive",
      "action_type": null,
      "flavor": {
        "summary": "Le paladin apprend à puiser dans la magie divine par la prière et la méditation. La préparation quotidienne des sorts requiert 1 minute par niveau de sort.",
        "lore_note": null
      },
      "spellcasting_ref": "spellcasting"
    },
    {
      "id": "feat-chatiment-divin",
      "name": "Châtiment divin",
      "unlocks_at_level": 2,
      "recharge": "at_will",
      "action_type": "no_action",
      "flavor": {
        "summary": "En touchant une créature avec une attaque au corps à corps, vous pouvez dépenser un emplacement de sort pour infliger des dégâts radiants supplémentaires.",
        "lore_note": null
      },
      "mechanics": {
        "trigger": "melee_weapon_attack_hit",
        "cost": "spell_slot",
        "damage_type": "radiant",
        "damage_dice_by_slot_level": {
          "1": "2d8",
          "2": "3d8",
          "3": "4d8",
          "4": "5d8",
          "5": "5d8"
        },
        "maximum_dice": "5d8",
        "bonus_damage_condition": {
          "target_is": [
            "mort-vivant",
            "ravageur-du-chancre",
            "fielon"
          ],
          "extra_dice": "1d8"
        }
      }
    },
    {
      "id": "feat-sante-divine",
      "name": "Santé divine",
      "unlocks_at_level": 3,
      "recharge": "passive",
      "action_type": null,
      "flavor": {
        "summary": "La magie divine qui coule dans vos veines vous immunise contre les maladies et renforce votre résistance psychique face à la corruption et à la folie.",
        "lore_note": "En cas de corruption par le Chancre, l'avantage aux jets contre la folie et la corruption est perdu."
      },
      "mechanics": {
        "immunities": [
          "disease"
        ],
        "advantages": [
          {
            "type": "saving_throw",
            "target": "corruption",
            "condition": null
