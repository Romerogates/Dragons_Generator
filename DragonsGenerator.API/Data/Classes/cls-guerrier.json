        "features_details": [
          {
            "id": "feat-arme-soeur",
            "name": "Arme sœur",
            "unlocks_at_level": 3,
            "recharge": "passive",
            "flavor": {
              "summary": "L'une de vos armes devient un objet magique intelligent lié à vous à vie. Bonus d'attaque/dégâts : +1 (→+2 niv.10, →+3 niv.18). Contient un sort mineur de magicien (1 lancer/repos court ou long). Points à répartir sur Int/Sag/Cha : 3 au niv.3, +2 aux niv.7/10/15, +1 au niv.18. Renaissance arcanique en cas de perte.",
              "lore_note": null
            },
