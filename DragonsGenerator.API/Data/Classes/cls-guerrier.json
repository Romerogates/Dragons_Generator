  "features_details": [
    {
      "id": "feat-style-de-combat-guerrier",
      "name": "Style de combat",
      "unlocks_at_level": 1,
      "recharge": "passive",
      "resolves_to_choice_pool": "choice-style-combat-cls-guerrier",
      "flavor": {
        "summary": "Spécialisation dans l'un des 6 styles de combat disponibles. Toute nouvelle sélection doit être une option différente.",
        "lore_note": null
      }
    },
    {
      "id": "feat-style-archerie",
      "name": "Style de combat : Archerie",
      "unlocks_at_level": 1,
      "recharge": "passive",
      "flavor": {
        "summary": "+2 aux jets d'attaque effectués avec des armes à distance.",
        "lore_note": null
      },
      "modifiers": [
        {
          "type": "attack_roll_bonus",
          "value": 2,
          "condition": "ranged_attack"
        }
      ]
    },
    {
      "id": "feat-style-armes-deux-mains",
      "name": "Style de combat : Armes à deux mains",
      "unlocks_at_level": 1,
      "recharge": "passive",
      "flavor": {
        "summary": "Lors d'une attaque avec une arme à propriété deux mains ou polyvalente, relance les dés de dégâts tombant sur 1 ou 2. Conserve le nouveau résultat même si 1 ou 2 à nouveau.",
        "lore_note": null
      }
    },
    {
      "id": "feat-style-combat-deux-armes",
      "name": "Style de combat : Combat à deux armes",
      "unlocks_at_level": 1,
      "recharge": "passive",
      "flavor": {
        "summary": "Lors du combat à deux armes, ajoute le modificateur de caractéristique aux dégâts de la seconde attaque.",
        "lore_note": null
      }
    },
    {
      "id": "feat-style-defense",
      "name": "Style de combat : Défense",
      "unlocks_at_level": 1,
      "recharge": "passive",
      "flavor": {
        "summary": "+1 à la Classe d'Armure tant que vous portez une armure.",
        "lore_note": null
      },
      "modifiers": [
        {
          "type": "ac_bonus",
          "value": 1,
          "condition": "wearing_armor"
        }
      ]
    },
    {
      "id": "feat-style-duel",
      "name": "Style de combat : Duel",
      "unlocks_at_level": 1,
      "recharge": "passive",
      "flavor": {
        "summary": "+2 aux jets de dégâts quand vous tenez une seule arme de corps à corps à une main et ne maniez pas d'autre arme.",
        "lore_note": null
      },
      "modifiers": [
        {
          "type": "damage_bonus",
          "value": 2,
          "condition": "single_one_handed_melee_no_other_weapon"
        }
      ]
    },
    {
      "id": "feat-style-protection",
      "name": "Style de combat : Protection",
      "unlocks_at_level": 1,
      "recharge": "at_will",
      "action_cost": "reaction",
      "flavor": {
        "summary": "Réaction : impose un désavantage à l'attaque d'une créature visible ciblant un allié dans 1,5 m. Requiert de porter un bouclier.",
        "lore_note": null
      }
    },
    {
      "id": "feat-second-souffle",
      "name": "Second souffle",
      "unlocks_at_level": 1,
      "recharge": "short_rest",
      "action_cost": "bonus_action",
      "uses": {
        "base": 1
      },
      "flavor": {
        "summary": "Récupère 1d10 + niveau de guerrier points de vie au prix d'une action bonus.",
        "lore_note": "Réserve d'endurance puisée dans les ressources martiales forgées par l'entraînement intensif."
      },
      "effect": {
        "heal_formula": "1d10 + class_level"
      }
    },
    {
      "id": "feat-fougue",
      "name": "Fougue",
      "unlocks_at_level": 2,
      "recharge": "short_rest",
      "action_cost": "none",
      "uses": {
        "base": 1,
        "upgrades": [
          {
            "at_level": 17,
            "value": 2,
            "constraint": "fougue_max_per_turn:1"
          }
        ]
      },
      "flavor": {
        "summary": "Effectue une action supplémentaire à votre tour (en plus de l'action normale et d'une éventuelle action bonus). 1/repos courts ou long. À partir du niv.17, 2/repos mais max 1 par tour.",
        "lore_note": null
      }
    },
    {
      "id": "feat-archetype-martial",
      "name": "Archétype martial",
      "unlocks_at_level": 3,
      "recharge": "passive",
      "flavor": {
        "summary": "Choisissez un idéal martial (Champion, Élu arcanique ou Ruffian). L'archétype choisi octroie des aptitudes aux niveaux 3, 7, 10, 15 et 18.",
        "lore_note": null
      }
    },
    {
      "id": "feat-augmentation-de-caracteristique",
      "name": "Augmentation de caractéristique",
      "unlocks_at_level": 4,
      "recharge": "passive",
      "repeats_at_levels": [
        4,
        6,
        8,
        12,
        14,
        16,
        19
      ],
      "flavor": {
        "summary": "+2 à une caractéristique ou +1 à deux caractéristiques différentes. Valeur maximale par cette aptitude : 20.",
        "lore_note": null
      }
    },
    {
      "id": "feat-attaque-supplementaire-guerrier",
      "name": "Attaque supplémentaire",
      "unlocks_at_level": 5,
      "recharge": "passive",
      "flavor": {
        "summary": "Nombre d'attaques lors de l'action Attaquer : 2 au niv.5, 3 au niv.11, 4 au niv.20.",
        "lore_note": null
      },
      "scaling": [
        {
          "at_level": 5,
          "resource_key": "extra_attacks",
          "value": 1,
          "total_attacks": 2
        },
        {
          "at_level": 11,
          "resource_key": "extra_attacks",
          "value": 2,
          "total_attacks": 3
        },
        {
          "at_level": 20,
          "resource_key": "extra_attacks",
          "value": 3,
          "total_attacks": 4
        }
      ]
    },
    {
      "id": "feat-aptitude-darchetype-guerrier",
      "name": "Aptitude d'archétype",
      "unlocks_at_level": 7,
      "recharge": "passive",
      "repeats_at_levels": [
        7,
        10,
        15,
        18
      ],
      "flavor": {
        "summary": "Aptitude supplémentaire conférée par l'archétype martial choisi au niveau 3. Voir la section de l'archétype pour le détail.",
        "lore_note": null
      }
    },
    {
      "id": "feat-inflexible-guerrier",
      "name": "Inflexible",
      "unlocks_at_level": 9,
      "recharge": "long_rest",
      "uses": {
        "base": 1,
        "upgrades": [
          {
            "at_level": 13,
            "value": 2
          },
          {
            "at_level": 17,
            "value": 3
          }
        ]
      },
      "flavor": {
        "summary": "Relancez un jet de sauvegarde raté et conservez le nouveau résultat. 1/repos long au niv.9, 2 au niv.13, 3 au niv.17.",
        "lore_note": null
      }
    }
  ],
