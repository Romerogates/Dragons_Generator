  "features_details": [
    {
      "id": "feat-sorts-ensorceleur",
      "name": "Sorts",
      "unlocks_at_level": 1,
      "recharge": "passive",
      "flavor": {
        "summary": "Un événement passé a légué une marque arcanique indélébile. La magie sourd de cette réserve intérieure.",
        "lore_note": null
      },
      "mechanics": {
        "spellcasting_ability": "cha",
        "spell_dc_formula": "8 + proficiency_bonus + cha_mod",
        "spell_attack_formula": "proficiency_bonus + cha_mod",
        "allows_swap_on_levelup": true,
        "swap_note": "À chaque niveau, un sort connu peut être remplacé par un autre sort de la liste ensorceleur de niveau disponible."
      }
    },
    {
      "id": "feat-atavisme",
      "name": "Atavisme",
      "unlocks_at_level": 1,
      "recharge": "passive",
      "flavor": {
        "summary": "Source des pouvoirs magiques innés. Octroie des aptitudes de sous-classe aux niveaux 1, 6, 14 et 18.",
        "lore_note": null
