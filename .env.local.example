# Variables optionnelles pour la stack locale (docker-compose.local.yml).
# Copier vers .env.local (gitignored) — chargé automatiquement par docker-compose.local.yml.
# Le SMTP local est forcé sur MailHog par le compose.
#
# Web     : http://localhost:8081
# API     : http://localhost:8080/swagger
# MailHog : http://localhost:8025

Groq__ApiKey=
App__PublicWebUrl=http://localhost:8081

# Compte perso en local (DevSeed, Development uniquement — ne pas committer)
# DevSeed__Users__1__Email=you@example.com
# DevSeed__Users__1__Password=YourPass123!
# DevSeed__Users__1__DisplayName=YourName
