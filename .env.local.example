# Variables optionnelles pour la stack locale (docker-compose.local.yml).
# Copier vers .env.local si besoin — le SMTP local est forcé sur MailHog par le compose.
#
# Web     : http://localhost:8081
# API     : http://localhost:8080/swagger
# MailHog : http://localhost:8025

Groq__ApiKey=
App__PublicWebUrl=http://localhost:8081
# Admin local
Admin__Email=admin@dragons.local
Admin__Password=AdminDragons!2026

# Comptes utilisateurs seed (DevSeed, Development uniquement)
# DevSeed__Enabled=true
# DevSeed__Users__0__Email=you@example.com
# DevSeed__Users__0__Password=YourPass123!
# DevSeed__Users__0__DisplayName=YourName
