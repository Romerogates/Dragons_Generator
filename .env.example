# Clé Groq (backstories IA) — obligatoire en prod pour /characters/backstory
Groq__ApiKey=gsk_...
# Gemini (vies / textes courts, quota gratuit AI Studio) — ne jamais committer la vraie clé
# Gemini__ApiKey=
# Gemini__BaseUrl=https://generativelanguage.googleapis.com/v1beta/openai
# Gemini__Model=gemini-3.8-flash
# Modèle Groq — groq/compound (français fiable). Éviter openai/gpt-oss-* (méta anglais).
Groq__Model=groq/compound
Groq__AdventureModel=qwen/qwen3.8-27b
# Modèle de secours si compound est saturé (NE PAS utiliser llama-3.3-70b-versatile — retiré par Groq)
Groq__FallbackModel=openai/gpt-oss-20b

# Ollama local (textes courts : backstory, vies de créatures)
LocalLlm__Enabled=true
LocalLlm__BaseUrl=http://ollama:11434/v1
LocalLlm__Model=qwen2.5:3b

# SMTP OVH Zimbra (prod / test réel)
# En local Docker, le SMTP est forcé sur MailHog — voir .env.local.example
# Après config SMTP : ajouter SPF + DKIM + DMARC — voir docs/EMAIL-DNS-OVH.md
Smtp__Host=smtp.mail.ovh.net
Smtp__Port=465
Smtp__UseSsl=true
Smtp__UserName=dragons@romerogates.be
Smtp__Password=CHANGE_ME
Smtp__FromEmail=dragons@romerogates.be
Smtp__FromName=Dragons Generator
# IMAP (boîte OVH lue dans le desk admin). Par défaut = mêmes identifiants SMTP.
Imap__Host=imap.mail.ovh.net
Imap__Port=993
Imap__UseSsl=true
# Imap__UserName=
# Imap__Password=
# Connexion Google — identifiant OAuth (origine https://dragons-generator.top + http://localhost:8081)
# Google__ClientId=xxxxx.apps.googleusercontent.com
# Alertes panne + backup quotidien (zip) — défaut script : Anthony.martinr@hotmail.be
Alert__Email=Anthony.martinr@hotmail.be
App__PublicWebUrl=https://dragons-generator.top
# Obligatoire en production (min. 32 caractères aléatoires)
Jwt__Key=CHANGE_ME_LONG_RANDOM_STRING_MIN_32_CHARS
Admin__Email=admin@votredomaine.com
Admin__Password=ChangeMeStrong!
# Admin__ResetPassword=true   # une seule fois au redémarrage API → remet le MDP de Admin__Email seulement

# Local Docker : docker-compose.local.yml force MailHog (localhost:8025) + admin@dragons.local / AdminDragons!2026
# Prod : Smtp__Host ne doit PAS être log / mailhog / localhost (sauf Smtp__AllowLogSink=true)
# Smtp__AllowLogSink=true

# Push notifications PWA (générées auto au deploy si absentes — scripts/ensure-vapid-keys.sh)
# Vapid__PublicKey=
# Vapid__PrivateKey=
# Vapid__Subject=mailto:noreply@dragons-generator.top
