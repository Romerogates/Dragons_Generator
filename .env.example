# Clé Groq (backstories IA) — obligatoire en prod pour /characters/backstory
Groq__ApiKey=gsk_...
# Modèle Groq — groq/compound (français fiable). Éviter openai/gpt-oss-* (méta anglais).
Groq__Model=groq/compound
Groq__AdventureModel=qwen/qwen3.6-27b
# Modèle de secours si compound est saturé (NE PAS utiliser llama-3.3-70b-versatile — retiré par Groq)
Groq__FallbackModel=qwen/qwen3.6-27b

# Ollama local (textes courts : backstory, vies de créatures)
LocalLlm__Enabled=true
LocalLlm__BaseUrl=http://ollama:11434/v1
LocalLlm__Model=qwen2.5:3b

# SMTP OVH Zimbra (prod / test réel)
# En local Docker, le SMTP est forcé sur MailHog — voir .env.local.example
# Après config SMTP : ajouter SPF + DKIM + DMARC — voir docs/EMAIL-DNS-OVH.md
Smtp__Host=smtp.mail.ovh.net
Smtp__Port=465
Smtp__UseSsl=true
Smtp__UserName=dragons@romerogates.be
Smtp__Password=CHANGE_ME
Smtp__FromEmail=dragons@romerogates.be
Smtp__FromName=Dragons Generator
App__PublicWebUrl=https://dragons-generator.top
Jwt__Key=CHANGE_ME_LONG_RANDOM_STRING
# Admin__Email=admin@votredomaine.com
# Admin__Password=ChangeMeStrong!
# Admin__ResetPassword=true   # une seule fois au redémarrage API → remet le MDP admin (Admin__Email) sans toucher aux autres comptes
